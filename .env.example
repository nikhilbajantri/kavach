# --- KAVACH gateway ---
# true = enforce policy; false = pass-through (still logged). Also switchable from the dashboard.
KAVACH_ENABLED=true
# Ed25519 private key (PEM) the credential broker signs 60-second action tokens with.
# Leave empty to generate a fresh key per process. The agent never sees it; upstreams get only the public key.
KAVACH_SIGNING_KEY_PEM=
# Where SQLite files live (CRM, inbox, evidence ledger).
KAVACH_DATA_DIR=./data
# Identity stamped on every action.
KAVACH_AGENT_ID=support-bot-1
KAVACH_OPERATOR=operator@ourbank.in

# --- Upstream secrets (held by KAVACH only, never by the agent) ---
RAZORPAY_KEY_SECRET=rzp_test_mock_secret

# --- LLM layer ---
# scripted (default, offline, deterministic) | anthropic | openai | ollama
LLM_PROVIDER=scripted
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Dashboard ---
NEXT_PUBLIC_API_URL=http://localhost:8000
